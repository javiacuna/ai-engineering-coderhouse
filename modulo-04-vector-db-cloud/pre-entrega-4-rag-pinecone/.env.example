# Copy this file to .env and fill in your keys (.env is never pushed to GitHub)
# The repo-level .env also works: the scripts look for it in the parent folders.

# Pinecone (free plan: https://app.pinecone.io)
PINECONE_API_KEY=
INDEX_NAME=rag-asyncio-docs
PINECONE_NAMESPACE=python-asyncio-docs

# Embeddings: gemini (free) or openai. Both produce 1536-dimension vectors for this index.
EMBEDDING_PROVIDER=gemini
GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Answer generation (ask.py --answer)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional tuning
# CHUNK_SIZE=500
# CHUNK_OVERLAP=75
# TOP_K=5
# VECTOR_WEIGHT=0.5
