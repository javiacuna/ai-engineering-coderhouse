# Copy this file to .env (here or at the repo root) and fill in the key of the provider you use.

# Active provider: openai | anthropic | gemini
LLM_PROVIDER=gemini

# API keys (only the active provider's key is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=          # GEMINI_API_KEY is also accepted

# Optional
# LLM_MODEL=                 # default: gpt-4o-mini | claude-haiku-4-5 | gemini-3.8-flash (or GEMINI_MODEL)
# LLM_FALLBACK_MODEL=        # backup model if the main one fails (with Gemini, GEMINI_FALLBACK_MODEL also works)
# LLM_MAX_TOKENS=1024
# LLM_MAX_ATTEMPTS=3         # total attempts when the answer is truncated or malformed
