# Copy this file to .env and fill in your keys (.env is never pushed to GitHub)

# Google Gemini (free tier: https://aistudio.google.com) - used from Module 2 on
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Pre-entrega 1: active provider (openai | anthropic | gemini)
LLM_PROVIDER=gemini

# OpenAI / Anthropic (optional, paid)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pinecone (free plan: https://app.pinecone.io) - used from Module 4 on
PINECONE_API_KEY=
# Pre-entrega 4
INDEX_NAME=rag-asyncio-docs
