# Copy this file to .env and fill in your key (.env is never pushed to GitHub)
# The repo-level .env also works: the scripts look for it in the parent folders.

GOOGLE_API_KEY=

# Generation
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Embeddings: the same model is used to index and to query
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Retrieval and chunking (optional)
# RAG_TOP_K=4
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_MAX_DISTANCE=

# Other providers (optional, paid)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
