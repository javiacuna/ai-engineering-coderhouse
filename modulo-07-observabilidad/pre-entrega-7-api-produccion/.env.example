# Copy this file to .env and fill in your key (.env is never pushed to GitHub).
# The repo-level .env also works: the app looks for it in the parent folders.

# ---- LLM (same as pre-entrega 6) ----
# gemini (free tier, default), openai, anthropic, or fake (offline rule-based model: no key, for demos/tests)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash                     # supervisor
GEMINI_WORKER_MODEL=gemini-flash-lite-latest      # specialists
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
RATE_LIMIT_WAIT_SECONDS=30                        # wait after a 429 before retrying
LLM_REQUESTS_PER_MINUTE=12                        # shared limit for the LLM calls of a process (default 12 with gemini; 0 = no limit)

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# redis = own checkpointer, works with any Redis | langgraph-redis = official RedisSaver (needs Redis 8 / Stack)
CHECKPOINTER=redis
CHECKPOINT_TTL_SECONDS=604800                     # 7 days: a job may wait a long time for approval
JOB_TTL_SECONDS=604800

# ---- Worker ----
RUN_WORKER_IN_API=true                            # false if you run `python -m app.worker` apart
WORKER_CONCURRENCY=5                              # jobs processed at the same time per process
JOB_TIMEOUT_SECONDS=600                           # a job running longer is marked FAILED

# ---- Observability (Arize Phoenix) ----
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=pe7-api-agente

# ---- Human-in-the-loop ----
HITL_COST_THRESHOLD_USD=0.007                     # estimated cost from which a task needs approval (3+ products)
COST_BASE_USD=0.0022
COST_PER_PRODUCT_USD=0.0017
