# Copy this file to .env (here or at the repo root) and fill in the key of the provider you use.

# Active provider: openai | anthropic | gemini
LLM_PROVIDER=gemini

# API keys (only the active provider's key is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=          # GOOGLE_API_KEY is also accepted

# Optional (defaults are used when not set)
# LLM_MODEL=             # gpt-4o-mini | claude-haiku-4-5 | gemini-3.8-flash
# LLM_TEMPERATURE=0.7    # 0 to 2 (Anthropic: 0 to 1)
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT=30         # seconds per call
# LLM_MAX_RETRIES=2      # automatic retries on 429, 5xx or network failures
