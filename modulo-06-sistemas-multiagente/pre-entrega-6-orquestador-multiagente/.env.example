# Copy this file to .env and fill in your key (.env is never pushed to GitHub)
# The repo-level .env also works: the scripts look for it in the parent folders.

# LLM provider: gemini (free tier, default), openai or anthropic
LLM_PROVIDER=gemini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash                     # supervisor: coordinates and validates
GEMINI_WORKER_MODEL=gemini-flash-lite-latest      # specialists: narrow tasks with tools
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest    # used if the primary model fails

# OPENAI_API_KEY=            # OPENAI_SUPERVISOR_MODEL=gpt-4o  OPENAI_WORKER_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=         # ANTHROPIC_SUPERVISOR_MODEL / ANTHROPIC_WORKER_MODEL
